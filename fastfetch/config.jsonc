{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "color": {"1": "white"},
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " :  "
    },
    "modules": [
	// "break",
	// {
    //         "type": "title",
    //         "color": {
    //             "user": "2",  // = color2
    //             "at": "2",
    //             "host": "2"
    //         }
    //     },

        "break",
        {
            "type": "custom",
            "key": " ",
            "format": "Sora-kun 空くん",
            "keyColor": "red"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "red"
        },
        // {
        //     "type": "kernel",
        //     "key": " ",
        //     "keyColor": "yellow"
        // },
        // {
        //     "type": "Packages",
        //     "format": "{}",
        //     "key": "󰏗 ",
        //     "keyColor": "blue",
        // },
        {
            "type": "terminal",
            "format": "{}",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "cpu",
            "format": "{}",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "format": "{} {6}",
            "keyColor": "blue"
        },
        // {
        //     "type": "shell",
        //     "key": "󰆍 ",
        //     "keyColor": "blue",
        // },

        {
            "type": "wm",
            "format": "{}",
            "key": " ",
            "keyColor": "green"
        },

        {
            "type": "media",
            "key": "󰝚 ",
            "format": "{1}({3})",
            "keyColor": "green"
        },

 
        "break", 
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
