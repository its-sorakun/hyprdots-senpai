* {
    /* Catppuccin Mocha Palette */
    bg0:    #1e1e2e; /* base */
    bg1:    #181825; /* mantle */
    bg2:    #313244; /* surface0 */
    bg3:    #cba6f7; /* mauve */
    fg0:    #cdd6f4; /* text */
    fg1:    #bac2de; /* subtext1 */
    fg2:    #a6adc8; /* subtext0 */
    fg3:    #45475a; /* surface1 */
    
    /* Opaque overlays */
    bb:     #1e1e2e; /* base */
    se:     #313244; /* surface0 */
    sel:    #181825; /* mantle */
    bor:    #cba6f7; /* mauve border highlight */
}

@import "rounded-common.rasi"
